<?xml version="1.0" encoding="UTF-8"?>

<!--
    FXML: usuario-view.fxml
+  Propósito: Interfaz para la gestión de cuentas de usuario (crear, actualizar, eliminar).
+
+  Controlador asociado: com.albertocr.gestionformularios.controller.usuario.UsuarioController
+
+  Campos clave (fx:id): tfNombreUsuario, pfContrasena, rolComboBox, botones de acción.
+
+  Seguridad: las contraseñas deben manejarse cuidadosamente; no mostrar contraseñas en texto claro
+  y utilizar hashing en el backend (BCrypt u otra librería segura).
+  Internacionalización: textos visibles deben cargarse desde bundles.
+-->
+
+
+<?import javafx.geometry.Insets?>
*** End Patch
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefWidth="500.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.albertocr.gestionformularios.controller.usuario.UsuarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Gestión de Cuentas de Usuario">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Nombre de Usuario:" />
                <TextField fx:id="tfNombreUsuario" promptText="ej: admin" GridPane.columnIndex="1" />
                <Label text="Contraseña:" GridPane.rowIndex="1" />
                <PasswordField fx:id="pfContrasena" promptText="Requerida para crear o actualizar" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Rol de Usuario:" GridPane.rowIndex="2" />
                <ComboBox fx:id="rolComboBox" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCrearUsuario" prefWidth="120.0" text="Crear Usuario" />
                <Button mnemonicParsing="false" onAction="#handleActualizarUsuario" prefWidth="160.0" text="Actualizar Contraseña" />
                <Button mnemonicParsing="false" onAction="#handleEliminarUsuario" prefWidth="120.0" text="Eliminar Usuario" style="-fx-background-color: #f5a7a7;" />
            </children>
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
