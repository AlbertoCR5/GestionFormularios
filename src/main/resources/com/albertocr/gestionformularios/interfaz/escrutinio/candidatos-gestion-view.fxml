<?xml version="1.0" encoding="UTF-8"?>

<!--
    FXML: candidatos-gestion-view.fxml
    Propósito: Interfaz de gestión de candidatos. Contiene la tabla de candidatos y el formulario
    para añadir/editar candidatos. Se carga desde la clase Java que crea la ventana (por ejemplo
    `VentanaGestionCandidatos`) y no define un `fx:controller` en este fichero.

    Notas importantes:
    - Los textos visibles deberían provenir de ResourceBundle para i18n (no hardcodear cadenas).
    - El nodo `Label fx:id="lblTitulo"` se actualiza programáticamente para sincronizar el
        título interior con el título del Stage.
    - Campos clave (fx:id): lblTitulo, tablaCandidatos, tfNombre, tfApellidos, tfDni,
        btnAnadir, btnEliminar, btnGuardar.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
    <Label fx:id="lblTitulo" text="Gestión de Candidatos" VBox.vgrow="NEVER">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <TableView fx:id="tablaCandidatos" prefHeight="250.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre y Apellidos" />
                <TableColumn fx:id="colDni" prefWidth="100.0" text="DNI" />
                <TableColumn fx:id="colAntiguedad" prefWidth="250.0" text="Antigüedad" />
                <TableColumn fx:id="colFechaNacimiento" prefWidth="120.0" text="Fecha Nacimiento" />
                <TableColumn fx:id="colSindicato" prefWidth="150.0" text="Sindicato" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <TitledPane animated="false" text="Añadir Nuevo Candidato">
            <content>
                <GridPane hgap="10.0" vgap="5.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="250.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="130.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Nombre y Apellidos:" />
                        <TextField fx:id="tfNombre" GridPane.rowIndex="1" />
                        <Label text="DNI:" GridPane.columnIndex="1" />
                        <TextField fx:id="tfDni" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Antigüedad:" GridPane.columnIndex="2" />
                        <TextField fx:id="tfAntiguedad" promptText="meses o dd/mm/yyyy" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <Label text="Fecha Nacimiento:" GridPane.columnIndex="3" />
                        <DatePicker fx:id="dpFechaNacimiento" prefWidth="130.0" promptText="dd/mm/yyyy" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        <Label text="Sindicato (Opcional):" GridPane.columnIndex="4" />
                        <TextField fx:id="tfSindicato" promptText="Sindicato" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                    </children>
                </GridPane>
            </content>
        </TitledPane>
        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button fx:id="btnAnadir" mnemonicParsing="false" text="Añadir Candidato" />
                <Button fx:id="btnEliminar" mnemonicParsing="false" text="Eliminar Seleccionado" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnGuardar" mnemonicParsing="false" text="Guardar y Cerrar" />
            </children>
        </HBox>
    </children>
</VBox>
