<?xml version="1.0" encoding="UTF-8"?>

<!--
    FXML: pdf-inspector-view.fxml
    Propósito: Herramienta administrativa para inspeccionar campos dentro de plantillas PDF.

    Controlador asociado: com.albertocr.gestionformularios.controller.admin.PdfInspectorController

    Notas:
    - Usa PDFBox en el backend para leer campos de formularios PDF.
    - Fx ids: pdfComboBox, loadingIndicator, fieldsTableView, exportAllButton, exportButton.
    - Mantener operaciones de I/O fuera del hilo de la UI; usar Task/Service para lecturas de PDFs.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="300.0" prefWidth="650.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.albertocr.gestionformularios.controller.admin.PdfInspectorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Inspector de Campos de Formularios PDF">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <ComboBox fx:id="pdfComboBox" onAction="#handlePdfSelection" promptText="Seleccione un formulario PDF para inspeccionar" HBox.hgrow="ALWAYS" />
                <ProgressIndicator fx:id="loadingIndicator" prefHeight="30.0" prefWidth="30.0" />
            </children>
        </HBox>
        <TableView fx:id="fieldsTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="fieldNameColumn" prefWidth="450.0" text="Nombre del Campo en el PDF" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="exportAllJsonButton" mnemonicParsing="false" onAction="#onExportToJsonButtonClick" text="Exportar Todo a un Único JSON" />
                <Button fx:id="exportAllInOneButton" mnemonicParsing="false" onAction="#handleExportAllInOne" text="Exportar Todo a un Único TXT" />
                <Button fx:id="exportAllButton" mnemonicParsing="false" onAction="#handleExportarTodo" text="Exportar Todo a TXT" />
                <Button fx:id="exportButton" mnemonicParsing="false" onAction="#handleExportar" text="Exportar a TXT" />
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
